{
  "name": "mirror-site",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "description": "基于 React + TypeScript + Material UI 构建的现代化镜像站前端，设计用于配合 tunasync 使用",
  "license": "GPL-3.0-or-later",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "rsbuild",
    "build": "bun run typecheck && rsbuild build && bun scripts/generate-sitemap.mjs",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "test:coverage": "rstest --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@tanstack/react-query": "^5.108.2",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.38.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-mdx": "^1.1.3",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rstest/adapter-rsbuild": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "~15.5.13",
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1",
    "typescript": "^7.0.2"
  }
}
